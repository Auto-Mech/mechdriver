els
#this is executed in the order they are specified 
    spc init_geom  runlvl=dft0 inplvl=dft0 
#    ts  find_ts runlvl=dft0 inplvl=dft0
    # all conf_energy runlvl=mp2 inplvl=dft #dft geom as input + spe at mp2     
    spc conf_opt  runlvl=dft inplvl=dft0
    spc conf_energy runlvl=dft inplvl=dft #dft geom as input + spe at mp2     
    all conf_opt  runlvl=dft inplvl=dft0
    all conf_energy runlvl=dft inplvl=dft #dft geom as input + spe at mp2     
    # add another all conf_energy here
    spc conf_hess  runlvl=dft inplvl=dft
    spc hr_scan runlvl=dft0 inplvl=dft0 tors_model=1dhrfa
    all conf_hess  runlvl=dft inplvl=dft
    all hr_scan runlvl=dft0 inplvl=dft0 tors_model=1dhrfa
end els 

